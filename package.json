{
  "name": "imgproxy-saver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "docker build -t imgproxy-saver:checkpoint . && node --import tsx --test test/e2e/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "sign": "node --import tsx scripts/sign.ts",
    "format": "prettier --write src test scripts *.json *.yaml",
    "format:check": "prettier --check src test scripts *.json *.yaml"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "file-type": "22.0.2",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
